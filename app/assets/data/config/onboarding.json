      "key": "baseline",
      "title": "基本盘",
      "required": true,
      "questions": [
        "gender",
        "birth_year",
        "height_weight"
      ],
      "granularity": "coarse"
    },
    {
      "key": "family",
      "title": "家庭与责任",
