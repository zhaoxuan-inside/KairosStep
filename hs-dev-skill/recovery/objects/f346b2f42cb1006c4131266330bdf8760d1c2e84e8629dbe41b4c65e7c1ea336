def classify_advice_deep(adv):
    t = adv['t']
    c = adv['c']
    tags = adv['tags']
    badge = adv.get('timing_badge', '')

    prereqs = {}

    # ========== 1. 深度提取画像守卫 (Prerequisites) ==========

    # 机动车 / 开车 / 乘车安全带
    if any(k in t for k in ['安全带', '行车记录仪', '驾驶', '刹车', '轮胎', '防冻液', '车载', '机动车', '疲劳驾驶', '超速', '酒驾']):
        if '电动' not in t and '自行车' not in t and '电梯' not in t:
            prereqs['has_car'] = True
    if '安全座椅' in t or '儿童乘车' in t:
        prereqs['has_car'] = True
        prereqs['has_children'] = True

    # 两轮电动车 / 摩托车
    if any(k in t for k in ['头盔', '电动自行车', '摩托车', '电瓶车', '电动车充电', '楼道充电']):
        prereqs['has_twowheeler'] = True

    # 吸烟者
    if any(k in t for k in ['戒烟', '伐尼克兰', '抽烟', '吸烟', '香烟', '电子烟', '重度吸烟者']):
        if '别在家里和车里抽烟' not in t and '二手烟' not in t and '本来不吸烟' not in t:
            prereqs['is_smoker'] = True

    # 子女 / 育儿 / 孕产
    if c in ['刚出生的孩子怎么带', '养孩子划不划算', '上学以后的孩子'] or any(k in t for k in ['防坠楼', '限位器', '儿童', '儿科', '母乳', '奶粉', '带娃', '幼儿园']):
        prereqs['has_children'] = True
    if c in ['怀孕和生产：从发现怀孕到出院办证'] or any(k in t for k in ['怀孕', '孕妇', '产检', '产后抑郁', '月子']):
        prereqs['is_pregnant_or_parent'] = True
        prereqs['gender_female'] = True

    # 父母 / 老人
    if c == '家里有老人' or any(k in t for k in ['家里有老人', '长辈', '父母的身体', '跌倒扶手', '养老金认证']):
        prereqs['has_aging_parents'] = True

    # 租房
    if c == '租房与买房' and any(k in t for k in ['租房', '房东', '押金', '转租', '中介费', '公租房', '合租']):
        prereqs['is_tenant'] = True

    # 买房 / 房贷
    if any(k in t for k in ['买房', '房贷', '提前还贷', '公积金贷款', '产权证', '首付', '物业费']):
        prereqs['has_mortgage'] = True

    # 宠物
    if any(k in t for k in ['犬', '狗', '猫', '狂犬疫苗', '宠物', '驱虫', '牵引绳']):
        prereqs['has_pets'] = True

    # 管道燃气
