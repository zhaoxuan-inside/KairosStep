def main():
    advice_path = 'app/assets/data/advice.json'
    with open(advice_path, 'r', encoding='utf-8') as f:
        data = json.load(f)

    advices = data['list']
    print(f'深度重构 {len(advices)} 条建议体系...')

    prereq_counts = {}
    path_counts = {}
    l1_counts = {}

    for adv in advices:
        info = classify_advice_deep(adv)
        adv['tree_path'] = info['tree_path']
        adv['tree_display'] = info['tree_display']
        adv['prerequisites'] = info['prerequisites']
        adv['cron'] = info['cron']

        p = info['tree_path']
        l1 = p.split('/')[0]
        path_counts[p] = path_counts.get(p, 0) + 1
        l1_counts[l1] = l1_counts.get(l1, 0) + 1

        for k in info['prerequisites']:
            prereq_counts[k] = prereq_counts.get(k, 0) + 1

    print('\n=== 六大一级支柱 (L1) 分布 ===')
    for l1, c in sorted(l1_counts.items(), key=lambda x: x[1], reverse=True):
        print(f'  {l1:15s}: {c} 条 ({c/len(advices)*100:.1f}%)')

    print('\n=== Top 20 树路径 (L3) 分布 ===')
    for p, c in sorted(path_counts.items(), key=lambda x: x[1], reverse=True)[:20]:
        print(f'  {p:35s}: {c} 条')

    print('\n=== 画像前置守卫 (Prerequisites) 统计 ===')
    for k, c in sorted(prereq_counts.items(), key=lambda x: x[1], reverse=True):
        print(f'  {k:25s}: {c} 条建议触发强准入')

    with open(advice_path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print(f'\n已成功保存 {advice_path}')

    tree_asset_path = 'app/assets/data/taxonomy_tree.json'
    with open(tree_asset_path, 'w', encoding='utf-8') as f:
        json.dump(TAXONOMY_TREE, f, ensure_ascii=False, indent=2)
    print(f'已成功保存 {tree_asset_path}')


if __name__ == '__main__':
    main()
